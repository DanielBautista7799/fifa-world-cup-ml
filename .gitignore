
Remove that.

## Replace `.gitignore` with this

```gitignore id="pcnbgc"
# Virtual environment
.venv/

# Python-generated files
__pycache__/
*.py[cod]
*.egg-info/

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Local secrets and environment variables
.env
.env.*
.streamlit/secrets.toml

# Operating system and editor files
.DS_Store
.vscode/

# Keep raw/interim/external data private or empty unless intentionally added
data/raw/*
data/interim/*
data/external/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/external/.gitkeep

# Ignore generated reports cache, but allow figures if wanted
reports/figures/*
!reports/figures/.gitkeep